# Copy this file to .env and fill in real values before running
# `docker compose up --build`. docker-compose.yml reads this automatically.

# MySQL root password (also used by the backend to connect)
DB_PASSWORD=changeme

# Database name
DB_NAME=aidssh_map

# Secret used to sign login sessions (JWT) — set this to something random
JWT_SECRET=changeme

# The URL the browser will use to reach the frontend (for backend CORS)
FRONTEND_URL=http://localhost:5173

# The URL the browser will use to reach the backend API (baked into the
# frontend build — changing this requires rebuilding the frontend image)
VITE_BACKEND_URL=http://localhost:3000
